MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/Portfolio?appName=Cluster0
PORT=3000
JWT_SECRET=<replace_with_a_long_random_secret>
NODE_ENV=development

# Optional (client build-time only, uncomment for split frontend/backend deploys).
# Leave unset for a single-service deploy: the frontend then calls same-origin
# relative paths (/api, /auth) and these are not needed.
# VITE_API_URL=https://your-backend.onrender.com/api
# VITE_AUTH_URL=https://your-backend.onrender.com/auth
